# Copy this file to .env.local and fill in your own Supabase project's values.
# Find both of these in your Supabase project: Settings -> API.

# The project URL, e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key — safe to expose to the browser, RLS policies
# in supabase/migrations/0001_init.sql are what actually protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add the "service_role" key here or to any NEXT_PUBLIC_ variable.
# It bypasses row-level security and must only ever live in a server-only
# secret store (e.g. Vercel's encrypted environment variables) if a future
# feature needs it — it does not for anything built so far.
